    "\n",
    "# 4. Little's-style check: logistic regression of missingness on observed variables\n",
    "df_fairness['is_missing'] = df_fairness[top_miss].isna().astype(int)\n",
    "pred = senslist + [m for m in measures if m != top_miss]\n",
    "df_m = df_fairness.dropna(subset=pred)\n",
    "Xm = sm.add_constant(df_m[pred].astype(float))\n",
    "miss_model = sm.Logit(df_m['is_missing'], Xm).fit(method='bfgs', maxiter=1000, disp=False)\n",
    "print(miss_model.summary())\n",
    "print(df_fairness.groupby('majority_group')['is_missing'].mean())\n"
