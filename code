    "# 1. Descriptive statistics for the sensitive attributes\n",
    "from itertools import combinations\n",
    "display(df_fairness[senslist].describe().round(3))\n",
    "\n",
    "# Majority group = race with the largest share in each community\n",
    "df_fairness['majority_group'] = df_fairness[senslist].idxmax(axis=1).map(\n",
    "    {'racepctblack': 'Black', 'racePctWhite': 'White',\n",
    "     'racePctAsian': 'Asian', 'racePctHisp': 'Hispanic'})\n",
    "print(df_fairness['majority_group'].value_counts())\n",
    "\n",
    "# Distributions of each measure by majority group\n",
    "for m in measures:\n",
    "    plt.figure(figsize=(6, 3))\n",
    "    sns.kdeplot(data=df_fairness, x=m, hue='majority_group', common_norm=False)\n",
    "    plt.title(m); plt.show()\n",
    "display(df_fairness.groupby('majority_group')[measures].mean().round(3))\n",
    "\n",
    "# 2. Pairwise K-S tests (continuous measures) with Bonferroni correction\n",
    "groups = sorted(df_fairness['majority_group'].unique())\n",
    "pairs = list(combinations(groups, 2))\n",
    "n_comp = len(pairs) * len(measures)\n",
    "alpha = 0.05 / n_comp\n",
    "print(f\"{len(measures)} measures x {len(pairs)} group pairs = {n_comp} comparisons; \"\n",
    "      f\"Bonferroni alpha = {alpha:.5f}\")\n",
    "rows = []\n",
    "for m in measures:\n",
    "    for g1, g2 in pairs:\n",
    "        a = df_fairness.loc[df_fairness.majority_group == g1, m].dropna()\n",
    "        b = df_fairness.loc[df_fairness.majority_group == g2, m].dropna()\n",
    "        if len(a) > 1 and len(b) > 1:\n",
    "            p = stats.ks_2samp(a, b).pvalue\n",
    "            rows.append((m, g1, g2, len(a), len(b), p, p < alpha))\n",
    "ks_res = pd.DataFrame(rows, columns=['measure', 'group1', 'group2', 'n1', 'n2', 'p_value', 'significant'])\n",
    "display(ks_res.sort_values('p_value'))\n",
    "print(\"Measures with at least one significant pair:\")\n",
    "print(ks_res.groupby('measure')['significant'].any())\n"
   ]
